# Copy to .env (git-ignored) and fill in. Never commit .env or paste its contents into a chat.
# Scheduled runs read this file, because they can't see settings exported in Terminal.
ANTHROPIC_API_KEY=

# OPTIONAL email. Leave EMAIL_TO empty to use macOS notifications only.
# For Gmail use an App Password (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
